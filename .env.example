# Copy with: cp .env.example .env
# .env files are loaded from this repo root and from llm_examples/.env.
# Process environment values always win; root .env overrides llm_examples/.env.

# Default app provider. Accepted aliases: openai, claude/anthropic, gemini,
# deepseek, qwen/dashscope, zai/z.ai, oca/codex/codex-oca.
AI_PROVIDER=openai
DEFAULT_AI_PROVIDER=

# UI persistence overrides (default file: .state/llm_ui_state.json at repo root).
LLM_EXAMPLES_STATE_FILE=
LLM_EXAMPLES_DISABLE_STATE=

# Generic max-token override applied to all providers.
AI_MAX_TOKENS=
MAX_TOKENS=

# Generic model override (used when provider-specific model envs are blank).
AI_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODEL_CHAT=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
CLAUDE_MODEL=
CLAUDE_CHAT_MODEL=

# Gemini (Google) via the OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Qwen (DashScope OpenAI-compatible)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
DASHSCOPE_MODEL=

# Z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=
Z_AI_MODEL=

# Codex / OCA (OpenAI-SDK-compatible LiteLLM proxy).
# If OCA_API_KEY / OCA_ACCESS_TOKEN are blank, the app reads ~/.codex/auth.json.
OCA_API_KEY=
OCA_ACCESS_TOKEN=
OCA_BASE_URL=https://code-internal.aiservice.us-chicago-1.oci.oraclecloud.com/20250206/app/litellm
OCA_MODEL=
MODEL_CHAT=
CODEX_AUTH_PATH=
OCA_CLIENT_HEADER=codex-cli
OCA_CLIENT_VERSION=1.0
REASONING_EFFORT=xhigh
